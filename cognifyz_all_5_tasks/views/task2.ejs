<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Task 2 | Cognifyz</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="/style.css"></head><body><%- include("partials-nav", { title: "Task 2: Validation and Temporary Storage" }) %><main class="container py-5"><div class="content-card"><h1 class="h3">Registration Form</h1><p class="text-secondary">Client-side checks improve usability; the server independently validates every field.</p><% if (result) { %><div class="alert alert-<%= result.type === 'success' ? 'success' : 'danger' %>"><%= result.text %></div><% } %><form id="registrationForm" method="POST" action="/task2" novalidate><div class="mb-3"><label class="form-label" for="name">Full name</label><input class="form-control" id="name" name="name" required minlength="2"></div><div class="mb-3"><label class="form-label" for="email">Email</label><input class="form-control" type="email" id="email" name="email" required></div><div class="mb-3"><label class="form-label" for="age">Age</label><input class="form-control" type="number" id="age" name="age" min="18" max="100" required></div><div class="mb-3"><label class="form-label" for="password">Password</label><input class="form-control" type="password" id="password" name="password" minlength="8" required><div class="form-text">At least 8 characters, uppercase, lowercase, and a number.</div></div><button class="btn btn-primary">Validate & Register</button><a class="btn btn-outline-secondary ms-2" href="/">Home</a></form></div></main><script>document.getElementById("registrationForm").addEventListener("submit", function(e) { const name = document.getElementById("name").value.trim(); const email = document.getElementById("email").value.trim(); const age = Number(document.getElementById("age").value); const password = document.getElementById("password").value; if (name.length < 2 || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) || age < 18 || age > 100 || password.length < 8 || !/[A-Z]/.test(password) || !/[a-z]/.test(password) || !/[0-9]/.test(password)) { e.preventDefault(); alert("Please correct the form. Check name, email, age (18–100), and password requirements."); } });</script></body></html>
