<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Task 4 | Cognifyz</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="/style.css"></head><body><%- include("partials-nav", { title: "Task 4: Complex Validation and Dynamic DOM" }) %><main class="container py-5"><div class="content-card"><h1 class="h3">Password Strength Checker</h1><p class="text-secondary">Type a password to update the strength meter and checklist dynamically.</p><label class="form-label" for="password">Enter Password</label><input class="form-control" type="password" id="password" autocomplete="new-password" placeholder="Enter Password"><div class="progress my-3" role="progressbar" aria-label="Password strength"><div id="strengthBar" class="progress-bar" style="width:0%"></div></div><p id="strengthText" class="fw-semibold">Strength: Not entered</p><ul class="list-group mb-4"><li class="list-group-item" id="lengthRule">○ At least 8 characters</li><li class="list-group-item" id="upperRule">○ One uppercase letter</li><li class="list-group-item" id="lowerRule">○ One lowercase letter</li><li class="list-group-item" id="numberRule">○ One number</li><li class="list-group-item" id="specialRule">○ One special character</li></ul><hr><h2 class="h5">Dynamic DOM update</h2><label class="form-label" for="textInput">Enter text</label><input class="form-control mb-2" id="textInput" placeholder="Original Text"><p id="updatedText" class="alert alert-secondary">Original Text</p><button id="updateButton" class="btn btn-primary">Update Text</button><hr><h2 class="h5">Greeting interaction</h2><button class="btn btn-outline-primary" id="greetingButton">Show Greeting</button><p class="mt-3 fw-semibold" id="greeting">Good Morning!</p><div class="mt-4"><a href="/task3" class="btn btn-outline-secondary">Previous Task</a> <a href="/task5" class="btn btn-primary">Next Task</a> <a href="/" class="btn btn-link">Home</a></div></div></main><script src="/script.js"></script></body></html>
