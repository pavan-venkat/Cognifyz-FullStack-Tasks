<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Task 1 | Cognifyz</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="/style.css"></head><body><%- include("partials-nav", { title: "Task 1: HTML Structure and Basic Server Interaction" }) %><main class="container py-5"><div class="content-card"><h1 class="h3">Contact Form</h1><p class="text-secondary">Submit the form to send data to the Express server. The response is rendered with EJS.</p><% if (result) { %><div class="alert alert-<%= result.type === 'success' ? 'success' : 'danger' %>"><%= result.text %></div><% } %><form method="POST" action="/task1"><div class="mb-3"><label class="form-label" for="name">Your name</label><input class="form-control" id="name" name="name" required minlength="2"></div><div class="mb-3"><label class="form-label" for="message">Message</label><textarea class="form-control" id="message" name="message" rows="4" required></textarea></div><button class="btn btn-primary">Submit to Server</button><a class="btn btn-outline-secondary ms-2" href="/">Home</a></form></div></main></body></html>
