<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Cognifyz | Full Stack Tasks</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<nav class="navbar navbar-dark bg-dark"><div class="container"><a class="navbar-brand fw-bold" href="/">Cognifyz</a><span class="navbar-text">Where Data Meets Intelligence</span></div></nav>
<header class="hero text-center"><div class="container"><span class="badge text-bg-warning mb-3">FULL STACK DEVELOPMENT</span><h1>Internship Tasks 1–5</h1><p class="lead">Learn, build, validate, and connect.</p></div></header>
<main class="container py-5"><div class="row g-4">
<% const tasks = [
{n:1,title:"HTML Structure & Server",desc:"HTML forms, Express routes, EJS rendering."},
{n:2,title:"Validation & Storage",desc:"Client/server validation and temporary storage."},
{n:3,title:"Responsive Design",desc:"Responsive layout, Bootstrap, CSS transitions."},
{n:4,title:"Dynamic DOM",desc:"Password strength checks and live DOM updates."},
{n:5,title:"REST API & CRUD",desc:"Create, read, update, and delete student records."}
]; %>
<% tasks.forEach(task => { %><div class="col-12 col-md-6 col-lg-4"><div class="card task-card h-100"><div class="card-body"><span class="badge rounded-pill text-bg-primary mb-3">TASK <%= task.n %></span><h2 class="h5"><%= task.title %></h2><p class="text-secondary"><%= task.desc %></p><a class="btn btn-primary" href="/task<%= task.n %>">Open Task <%= task.n %></a></div></div></div><% }) %>
</div><p class="text-secondary small mt-4">Note: Tasks 2 and 5 use temporary in-memory data. Records reset when the server restarts.</p></main>
<footer class="text-center py-4 bg-light">Cognifyz Full Stack Development Internship Demo</footer>
</body></html>
